# Node.js dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment variables
.env
.env.*
!.env.example          # optionally allow example env file

# Build / distribution outputs
dist/
build/
out/
lib/                   # if you compile to lib

# Coverage directories
coverage/
.nyc_output/

# TypeScript compiled output (if using TS)
*.tsbuildinfo

# Logs
logs/
*.log

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov/

# Optional npm cache directory
.npm

# Optional REPL history
.node_repl_history

# IDE / editor files
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Testing / temporary files
*.tmp
*.temp

# Webpack / parcel / other bundler caches
.parcel-cache/
.cache/
.webpack/

# ESLint / Prettier cache
.eslintcache
.prettiercache

# Misc
*.tgz
*.tar.gz